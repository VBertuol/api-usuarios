# Copie este arquivo para .env e preencha.
# Na Vercel, estas mesmas variáveis vão em Settings > Environment Variables.

# Banco (string do Neon, com pool: o host termina em -pooler)
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require

# Segredo do JWT: gere com
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
NODE_ENV=development
PORT=3000
